# =============================================================================
# Finance Operations Toolkit — environment configuration
# Copy this file to `.env.local` and fill in real values. Never commit secrets.
# =============================================================================

# --- Email (SMTP) -----------------------------------------------------------
# Required to send transaction PDFs by email. Without these, the app still
# generates PDFs for manual download.
#
# For Gmail, create an "App Password" (Google Account > Security > App
# passwords) and use it as SMTP_PASS with SMTP_HOST=smtp.gmail.com.
SMTP_HOST=
SMTP_PORT=587
# Set to "true" only if using port 465 (implicit TLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# The "From" address shown on outgoing mail (defaults to SMTP_USER).
MAIL_FROM=

# Pre-fills the recipient field for the Orange Cameroun task.
ORANGE_PDF_RECIPIENT=

# --- Data store -------------------------------------------------------------
# Where remembered customer names are persisted. Defaults to ./data
# DATA_DIR=/var/lib/finance-toolkit
